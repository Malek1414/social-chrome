# Code only. Everything Social Chrome captures (videos, frames, transcripts,
# scraped JSON, logs, queues) stays on this Mac and out of git.
/*
!/.gitignore
!/README.md
!/*.mjs
!/*.sh
!/*.py
!/*.command
!/igdisc/
/igdisc/*
!/igdisc/*.sh
!/igdisc/*.py
!/igdisc/*.mjs
!/own-ig/
/own-ig/*
!/own-ig/*.py
!/own-ig/*.mjs
!/own-ig/*.sh
.DS_Store
__pycache__/
!/CLAUDE.md
!/lib/
